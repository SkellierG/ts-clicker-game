{
  "name": "ts-clicker-game",
  "version": "0.0.1",
  "description": "node typescript web server clicker game",
  "keywords": [
    "game",
    "clicker",
    "typrescript",
    "nodejs",
    "backend",
    "web",
    "fun"
  ],
  "license": "MIT",
  "author": "skellierg",
  "type": "module",
  "main": "dist/server/main.js",
  "scripts": {
    "dev:server": "tsc --watch & nodemon dist/server/main.js",
    "dev:client": "npm --prefix client run dev",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server & npm run build:client"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "24.10.2",
    "nodemon": "^3.1.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
